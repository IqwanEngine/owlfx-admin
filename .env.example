# --- OWL ALGO DATABASE - ENVIRONMENT VARIABLES TEMPLATE ---
# Copy this file to .env and fill in the actual values.

# 1. GOOGLE SHEETS / APPS SCRIPT ENDPOINTS
# The /exec URL for your Google Apps Script (Malaysia & Indonesia)
GOOGLE_SHEETS_MY_ENDPOINT=https://script.google.com/macros/s/XXXXX/exec?action=fetch
GOOGLE_SHEETS_ID_ENDPOINT=https://script.google.com/macros/s/XXXXX/exec?action=fetch

# 2. AUTHENTICATION & SECURITY
# Comma-separated list of authorized admin emails
ADMIN_ALLOWED_EMAILS=admin@owlfx.my,hairul@owlfx.my,iqwan@owlfx.my

# Optional secret for session/cookie signing (if using libraries like next-auth or express-session)
SESSION_SECRET=your_long_random_session_secret_here

# 3. VALETAX & THIRD-PARTY APIS (IF APPLICABLE)
VALETAX_API_TOKEN=your_valetax_token_here

# 4. FRONTEND CONFIGURATION (VITE)
# Base URL for API calls if different from the host
VITE_API_BASE_URL=
